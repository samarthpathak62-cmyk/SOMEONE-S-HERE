; Engine configuration file.
; Open this folder in Godot 4.x and press F5 (Run Project) to test the map & controls.

config_version=5

[application]

config/name="SOMEONE'S HERE - Map & Controls Test"
config/description="Fears to Fathom style retro PSX psychological horror - Map & Player Controls Test Build"
run/main_scene="res://scenes/main_map_test.tscn"
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[rendering]

; Compatibility (OpenGL) renderer: much lighter than Forward+ on laptops without a dedicated GPU
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0

[physics]

3d/physics_engine="GodotPhysics3D"
